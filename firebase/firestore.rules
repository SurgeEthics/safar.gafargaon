rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Vehicle Categories (CNG, Auto, Bike, Ambulance, etc.)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true; // In production, restrict to authenticated admin
    }

    // 2. Transport Stands (গফরগাঁও রেল স্টেশন স্ট্যান্ড, নতুন বাজার, ইত্যাদি)
    match /stands/{standId} {
      allow read: if true;
      allow write: if true; // In production, restrict to authenticated admin
    }

    // 3. Driver Profiles & Live Status
    match /drivers/{driverId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // 4. Ride Bookings & Instant Requests
    match /bookingRequests/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // 5. Trip History
    match /trips/{tripId} {
      allow read, write: if true;
    }

    // 6. Global App Settings, Marquee Announcements, and Emergency Contacts
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
