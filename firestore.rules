rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Places collection (Viewable and syncable for Gafargaon navigation and pickup)
    match /places/{placeId} {
      allow read: if true;
      allow write: if true;
    }

    // Drivers collection (Viewable by all passengers, editable by admin/drivers)
    match /drivers/{driverId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Stands collection (Viewable by all, editable from Super Admin Control Panel)
    match /stands/{standId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection (Viewable by all, editable from Super Admin Control Panel)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // App Settings collection (Colors, themes, density, widgets, URLs)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Hotlines collection (Hospital, Fire, Police, National emergency numbers)
    match /hotlines/{hotlineId} {
      allow read: if true;
      allow write: if true;
    }

    // Ride Requests collection (Passengers create, drivers update status)
    match /ride_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection & Passenger Trip History subcollection
    match /users/{userId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Passengers collection (Passenger accounts, authentication PINs, profiles)
    match /passengers/{passengerId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Driver Reviews collection (Ratings & Reviews submitted by passengers)
    match /driver_reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp verifications collection
    match /whatsapp_verifications/{verificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
